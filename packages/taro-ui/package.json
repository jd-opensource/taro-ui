{
  "name": "taro-ui",
  "version": "3.3.2",
  "description": "UI KIT for Taro",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "style": "dist/style/index.css",
  "source": "src/index.ts",
  "react-native": "rn/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.esm.js"
    },
    "./dist/*": "./dist/*",
    "./dist/style/index.css": "./dist/style/index.css",
    "./lib/*": "./dist/*"
  },
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "types": "dist/index.d.ts",
  "keywords": [
    "taro",
    "taro-ui",
    "ui"
  ],
  "files": [
    "dist",
    "rn"
  ],
  "author": "O2Team <aotu.io>",
  "homepage": "https://jd-opensource.github.io/taro-ui/#/",
  "repository": {
    "type": "git",
    "url": "git@github.com:nervjs/taro-ui.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "tsup --watch",
    "build": "node config/iconsMaker.js && tsup && node config/copy-assets.js && pnpm run build:dts && pnpm run build:css",
    "build:dts": "tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build:css": "node -e \"require('fs').cpSync('src/style', 'dist/style', {recursive:true, force:true})\" && sass --silence-deprecation=import --silence-deprecation=slash-div src/style/index.scss dist/style/index.css",
    "lint": "eslint ./src --fix",
    "lint:style": "stylelint \"src/**/*.scss\" --syntax scss",
    "lint:style-fix": "stylelint \"src/**/*.scss\" --syntax scss --fix",
    "test": "cross-env NODE_ENV=test && jest --coverage",
    "test:ci": "pnpm run build:h5 && pnpm run test",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "clean": "rimraf .temp dist lib coverage"
  },
  "dependencies": {
    "classnames": "^2.2.6",
    "dayjs": "^1.7.7",
    "lodash": "^4.17.10",
    "prop-types": "^15.7.2"
  },
  "devDependencies": {
    "@tarojs/components": "3.6.40",
    "@tarojs/react": "3.6.40",
    "@tarojs/runtime-rn": "3.6.40",
    "@tarojs/taro": "3.6.40",
    "@types/node": "~16.6.0",
    "camelize": "^1.0.0",
    "react-native": "^0.71.6",
    "sass": "^1.50.0",
    "tsup": "^8.5.1",
    "typescript": "~5.3.3"
  },
  "peerDependencies": {
    "@tarojs/components": ">=3",
    "@tarojs/plugin-platform-alipay": ">=3",
    "@tarojs/plugin-platform-h5": ">=3",
    "@tarojs/plugin-platform-jd": ">=3",
    "@tarojs/plugin-platform-qq": ">=3",
    "@tarojs/plugin-platform-swan": ">=3",
    "@tarojs/plugin-platform-tt": ">=3",
    "@tarojs/plugin-platform-weapp": ">=3",
    "@tarojs/react": ">=3",
    "@tarojs/taro": ">=3",
    "@tarojs/taro-rn": ">=3",
    "react": ">=16.13.0",
    "react-dom": ">=16.13.0",
    "react-native": ">=0.62.0",
    "react-native-modal": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-modal": {
      "optional": true
    }
  },
  "gitHead": "c33cc7fbb734f0dbdd6e305dda1bc8300e5adbe2"
}
